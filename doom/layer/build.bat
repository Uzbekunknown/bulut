@echo off
rem build.bat - the cloud simulator layer (cloud_sim_vk.dll + manifest), input_logger.exe and the test app.
rem   doom\layer\build.bat        output: doom\layer\build
rem Needs the MSVC x64 compiler (Visual Studio 2022 or its Build Tools; found with vswhere when cl is
rem not on the PATH) and the Vulkan SDK (VULKAN_SDK, else the newest folder in C:\VulkanSDK).
setlocal
set "HERE=%~dp0"
set "OUT=%HERE%build"
set "GEN=%OUT%\gen"
set "SDK=%VULKAN_SDK%"
if not defined SDK for /d %%d in ("C:\VulkanSDK\*") do set "SDK=%%d"
if not exist "%SDK%\Include\vulkan\vulkan.h" goto :no_sdk
set "GLSLC=%SDK%\Bin\glslc.exe"
if not exist "%OUT%" mkdir "%OUT%"
if not exist "%GEN%" mkdir "%GEN%"
where cl >nul 2>nul
if not errorlevel 1 goto :have_cl
set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
if not exist "%VSWHERE%" goto :no_cl
set "VSDIR="
for /f "usebackq delims=" %%i in (`"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VSDIR=%%i"
if not defined VSDIR goto :no_cl
call "%VSDIR%\VC\Auxiliary\Build\vcvars64.bat" >nul
where cl >nul 2>nul
if errorlevel 1 goto :no_cl
:have_cl

> "%GEN%\sim_spv.h" echo /* generated by build.bat from sim.comp */
call :kernel 1 bwarp || exit /b 1
call :kernel 2 pdown || exit /b 1
call :kernel 3 pfill || exit /b 1
call :kernel 4 pup || exit /b 1
call :kernel 5 zoom || exit /b 1
call :kernel 6 overlay || exit /b 1
call :kernel 7 luma || exit /b 1
call :kernel 8 dstat || exit /b 1
call :kernel 9 half || exit /b 1
call :kernel 10 clear || exit /b 1
call :kernel 11 splatz || exit /b 1
call :kernel 12 splatc || exit /b 1
call :kernel 13 hfill || exit /b 1

> "%GEN%\test_spv.h" echo /* generated by build.bat from test.vert, test.frag */
"%GLSLC%" -O --target-env=vulkan1.0 -mfmt=c -o "%GEN%\test_vert.inc" "%HERE%test.vert" || exit /b 1
"%GLSLC%" -O --target-env=vulkan1.0 -mfmt=c -o "%GEN%\test_frag.inc" "%HERE%test.frag" || exit /b 1
>> "%GEN%\test_spv.h" echo static const uint32_t spv_test_vert[] =
type "%GEN%\test_vert.inc" >> "%GEN%\test_spv.h"
>> "%GEN%\test_spv.h" echo ;
>> "%GEN%\test_spv.h" echo static const uint32_t spv_test_frag[] =
type "%GEN%\test_frag.inc" >> "%GEN%\test_spv.h"
>> "%GEN%\test_spv.h" echo ;

cl /nologo /O2 /W4 /std:c11 /TC /utf-8 /I"%SDK%\Include" /I"%GEN%" /Fo:"%OUT%\cloud_sim_vk.obj" /Fe:"%OUT%\cloud_sim_vk.dll" /LD "%HERE%cloud_sim_vk.c" /link /DEF:"%HERE%cloud_sim_vk.def" user32.lib
if errorlevel 1 ( echo ERROR: the layer failed & exit /b 1 )
copy /y "%HERE%VkLayer_UZ_cloud_sim.json" "%OUT%\VkLayer_UZ_cloud_sim.json" >nul
cl /nologo /O2 /W4 /std:c11 /TC /utf-8 /Fo:"%OUT%\input_logger.obj" /Fe:"%OUT%\input_logger.exe" "%HERE%input_logger.c" /link /SUBSYSTEM:WINDOWS user32.lib shell32.lib
if errorlevel 1 ( echo ERROR: input_logger failed & exit /b 1 )
cl /nologo /O2 /W4 /std:c11 /TC /utf-8 /I"%SDK%\Include" /I"%GEN%" /Fo:"%OUT%\test_vk_sim.obj" /Fe:"%OUT%\test_vk_sim.exe" "%HERE%test_vk_sim.c" /link "%SDK%\Lib\vulkan-1.lib" user32.lib
if errorlevel 1 ( echo ERROR: the test failed to build & exit /b 1 )
echo built %OUT%\cloud_sim_vk.dll, VkLayer_UZ_cloud_sim.json, input_logger.exe and test_vk_sim.exe
exit /b 0

:no_sdk
echo ERROR: no Vulkan SDK: install it from LunarG, or set VULKAN_SDK to its folder
exit /b 1

:no_cl
echo ERROR: no MSVC x64 compiler: install Visual Studio 2022 with the C++ tools, or run this from its x64 Native Tools prompt
exit /b 1

:kernel
"%GLSLC%" -O --target-env=vulkan1.0 -fshader-stage=compute -DKERNEL=%1 -mfmt=c -o "%GEN%\%2.inc" "%HERE%sim.comp" || exit /b 1
>> "%GEN%\sim_spv.h" echo static const uint32_t spv_%2[] =
type "%GEN%\%2.inc" >> "%GEN%\sim_spv.h"
>> "%GEN%\sim_spv.h" echo ;
exit /b 0
